# Frontend — URL the browser uses to reach the API.
# Production (Netlify): leave unset — the API is served at /api on the same
# origin as the frontend. Local development defaults to the Go API on :8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Frontend — canonical site URL for SEO/OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend (local development only) — CORS origin allowed to call the API
ALLOWED_ORIGIN=http://localhost:3000
