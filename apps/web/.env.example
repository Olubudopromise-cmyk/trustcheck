# URL the browser uses to reach the TrustCheck API.
# Leave unset in production so the Netlify Function is reached at /api on the
# same origin. Set this only when the API is hosted elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical site URL for SEO/OpenGraph metadata (e.g. https://trustcheck.netlify.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
